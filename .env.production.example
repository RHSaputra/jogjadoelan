# ==============================================================================
# JOGJADOELAN PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Salin konfigurasi ini ke Dashboard Vercel: Project Settings -> Environment Variables

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TiDB Cloud Serverless - 100% Free Forever, 5GB)
# ------------------------------------------------------------------------------
# Format: mysql://<USER>.<PREFIX>:<PASSWORD>@<GATEWAY_HOST>:4000/<DB_NAME>?sslaccept=strict
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?sslaccept=strict"

# Batas koneksi per serverless instance Vercel (Default: 3)
DATABASE_CONNECTION_LIMIT=3

# ------------------------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION (NextAuth.js)
# ------------------------------------------------------------------------------
# Domain domain produksi Vercel (contoh: https://jogjadoelan.com atau https://jogjadoelan.vercel.app)
NEXT_PUBLIC_APP_URL="https://jogjadoelan.vercel.app"

# Kunci rahasia enkripsi sesi JWT NextAuth (generate via: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
AUTH_TRUST_HOST=true
NODE_ENV="production"

# Google OAuth (Opsional - Login dengan Google)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. STORAGE & MEDIA (Vercel Blob Public)
# ------------------------------------------------------------------------------
BLOB_STORE_ID="store_your_blob_store_id"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_read_write_token"

# ------------------------------------------------------------------------------
# 4. REALTIME NOTIFICATIONS & CHAT (Pusher)
# ------------------------------------------------------------------------------
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS & NOTIFICATIONS (Email & WhatsApp)
# ------------------------------------------------------------------------------
# Resend (Email Transaksional)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="orders@jogjadoelan.com"
EMAIL_FROM_NAME="Jogjadoelan"

# Fonnte (WhatsApp Gateway)
FONNTE_TOKEN="your_fonnte_token"

# ------------------------------------------------------------------------------
# 6. LOGISTICS & SHIPPING (Biteship & Binderbyte)
# ------------------------------------------------------------------------------
BITESHIP_API_KEY="biteship_live_your_api_key"
BITESHIP_ORIGIN_POSTAL="55782"
BITESHIP_ORIGIN_LAT="-7.7956"
BITESHIP_ORIGIN_LNG="110.3695"
BINDERBYTE_API_KEY="your_binderbyte_api_key"
