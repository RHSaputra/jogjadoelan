model whatsappbroadcast {
  id          String                 @id @default(cuid())
  channel     String                 @default("wa") // "wa" | "email" | "notif"
  judul       String
  pesan       String                 @db.Text
  gambar      String?                @db.Text
  target      String                 // "semua" | "aktif" | "custom"
  status      String                 @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  total       Int                    @default(0)
  terkirim    Int                    @default(0)
  gagal       Int                    @default(0)
  pending     Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  logs        whatsappbroadcastlog[]
}

model whatsappbroadcastlog {
  id          String             @id @default(cuid())
  broadcastId String
  nama        String
  noHp        String?
  email       String?
  userId      String?
  status      String             @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  error       String?            @db.Text
  retries     Int                @default(0)
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  broadcast   whatsappbroadcast  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

model whatsapptransactional {
  id        String    @id @default(cuid())
  noHp      String
  nama      String
  tipe      String    // "REGISTRASI" | "OTP" | "ORDER_CREATED" | "PAYMENT_RECEIVED" | "ORDER_PROCESSED" | "ORDER_SHIPPED" | "ORDER_COMPLETED"
  pesan     String    @db.Text
  status    String    @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  error     String?   @db.Text
  retries   Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model notificationlog {
  id                String    @id @default(cuid())
  channel           String    // "email" | "whatsapp"
  recipient         String
  template          String?
  subject           String?
  message           String    @db.Text
  status            String    @default("pending") // "pending" | "sent" | "delivered" | "read" | "failed"
  provider          String?   // "resend" | "fonnte"
  provider_response Json?
  created_at        DateTime  @default(now())
  sent_at           DateTime?
  delivered_at      DateTime?
  failed_at         DateTime?
  related_order_id  String?
  related_user_id   String?

  @@index([channel])
  @@index([recipient])
  @@index([status])
  @@index([created_at])
  @@index([related_order_id])
  @@index([related_user_id])
}