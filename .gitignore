# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# backup env (rahasia, JANGAN commit)
.env.backup

# env files (rahasia, JANGAN commit)
.env
.env.local
.env.*.local

# TAPI kecualikan .env.example (wajib commit sebagai template)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/lib/generated/prisma

# Environment
.env
.env.local
.env.*.local
# Prisma
/prisma/migrations/dev.db
/prisma/migrations/dev.db-journal
/prisma/seed-data/export-localstorage.json
/prisma/seed-data/*-private.json
# Upload files (jangan commit isi upload, cuma struktur folder)
/public/uploads/**/*
!/public/uploads/**/.gitkeep

# tool lokal & artefak AI/preview
/cloudflared.exe
/email-previews/
/.qodo/
/tsconfig.tsbuildinfo

# editor/backup files
*.backup
